<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:moduleViewModels="clr-namespace:SonicEddy.ViewModels.ModuleViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Views.ModuleViews.ModuleManagerView"
             x:DataType="moduleViewModels:ModuleManagerViewModel">
    <SplitView IsPaneOpen="True"
               DisplayMode="Inline"
               PanePlacement="Right"
               OpenPaneLength="200">
        <SplitView.Pane>
            <HeaderedContentControl Header="Menu"
                                    Margin="4">
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch"
                                    Padding="8"
                                    Margin="4"
                                    Content="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>
        </SplitView.Pane>

        <HeaderedContentControl Header="Module Details"
                                Margin="4">
            <Grid RowDefinitions="Auto,*">
                <Panel Grid.Row="0">
                    <Button Content="&#xE005;"
                            FontFamily="{StaticResource FluentIconsRegular}"
                            FontSize="20"
                            ToolTip.Tip="Create Module ..."
                            Padding="8"
                            Margin="4"
                            Command="{Binding CreateModule}" />
                </Panel>

            </Grid>
        </HeaderedContentControl>
    </SplitView>
</UserControl>