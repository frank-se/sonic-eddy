<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:graphEditorControl="clr-namespace:SonicEddy.Controls.GraphEditorControl"
             xmlns:graphControlTesterViewModels="clr-namespace:SonicEddy.ViewModels.GraphControlTesterViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Views.GraphControlTesterViews.GraphControlTesterView"
             x:DataType="graphControlTesterViewModels:GraphControlTesterViewModel">
    <HeaderedContentControl Header="Graph"
                            Margin="4">
        <graphEditorControl:GraphEditor 
            Background="DarkSlateGray"
            GraphNodes="{Binding Nodes}" />
    </HeaderedContentControl>
</UserControl>