<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SonicEddy.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:reactiveUi="http://reactiveui.net"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Width="1200" Height="1000"
        x:Class="SonicEddy.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SonicEddy">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext
             property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background"
                    Value="{DynamicResource ToggleButtonBackground}" />
        </Style>

        <Style Selector="Button.selected">
            <Setter Property="Background"
                    Value="{DynamicResource ToggleButtonBackgroundChecked}" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" />
                <MenuItem Header="_Load ..." />
                <MenuItem Header="_Save" />
                <MenuItem Header="Save As ..." />
                <Separator />
                <MenuItem Header="Preferences ..."
                          Command="{Binding ShowPreferencesWindow}" />
            </MenuItem>

            <MenuItem Header="_Mixer">
                <MenuItem Header="Add Channel ..." />
            </MenuItem>

            <MenuItem Header="Tools">
                <MenuItem Header="Filter Graphs ..."
                          Command="{Binding ShowFilterGraphManagerWindow}" />
                <MenuItem Header="Modules ..."
                          Command="{Binding ShowModuleManagerWindow}" />
                <MenuItem Header="Metadata ..."
                          Command="{Binding ShowMetadataBrowserWindow}" />
                <MenuItem Header="Objects ..."
                          Command="{Binding ShowObjectBrowserWindow}" />
                <MenuItem Header="Virtual Inputs ..."
                          Command="{Binding ShowVirtualInputsWindow}" />
                <MenuItem Header="Virtual Outputs ..." />
            </MenuItem>
        </Menu>

        <SplitView IsPaneOpen="True"
                   DisplayMode="Inline"
                   OpenPaneLength="120">
            <SplitView.Pane>
                <StackPanel Background="Black">
                    <Button HorizontalAlignment="Stretch"
                            Padding="8"
                            Margin="4"
                            Classes.selected="{Binding MixerViewV2ViewSelected}"
                            Command="{Binding NavigateToMixerV2View}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF6FB;"
                                       FontFamily="{StaticResource FluentIconsRegular}"
                                       FontSize="24"
                                       Margin="4" />

                            <TextBlock Text="MIX"
                                       FontSize="20"
                                       Margin="4" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch"
                            Padding="8"
                            Margin="4"
                            Classes.selected="{Binding MidiConnectionEditorViewSelected}"
                            Command="{Binding NavigateToMidiConnectionEditorView}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF35C;"
                                       FontFamily="{StaticResource FluentIconsRegular}"
                                       FontSize="24"
                                       Margin="4" />

                            <TextBlock Text="MIDI"
                                       FontSize="20"
                                       Margin="4" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch"
                            Padding="8"
                            Margin="4"
                            Classes.selected="{Binding CustomControlTesterViewSelected}"
                            Command="{Binding NavigateToCustomControlTesterView}">
                        Custom Control Tester
                    </Button>
                    <!--
                        <Button HorizontalAlignment="Stretch"
                                Padding="8"
                                Margin="4"
                                Classes.selected="{Binding MixerManagerViewSelected}"
                                Command="{Binding NavigateToMixerManagerAction}">
                            Mixer Manager
                        </Button>
                        <Button HorizontalAlignment="Stretch"
                                Padding="8"
                                Margin="4"
                                Classes.selected="{Binding GraphControlTesterViewSelected}"
                                Command="{Binding NavigateToGraphControlTesterView}">
                            Graph Control Tester
                        </Button>
                        -->
                </StackPanel>
            </SplitView.Pane>
            <reactiveUi:RoutedViewHost Router="{Binding Router}" />
        </SplitView>
    </DockPanel>
</Window>