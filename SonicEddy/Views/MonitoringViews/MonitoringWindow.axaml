<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SonicEddy.ViewModels.MonitoringViewModels"
        xmlns:monitoringControls="clr-namespace:SonicEddy.Controls.MonitoringControls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="400"
        Width="1000" Height="400"
        WindowStartupLocation="CenterOwner"
        x:Class="SonicEddy.Views.MonitoringViews.MonitoringWindow"
        x:CompileBindings="False"
        x:DataType="vm:MonitoringViewModel"
        Title="Monitoring">

    <Grid ColumnDefinitions="*,5,Auto">

        <!-- Pickup selection -->
        <TabControl Grid.Column="0">
            <TabItem Header="Layer 1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="4">
                        <monitoringControls:MonitoringPickupColumn Header="CH1"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="CH2"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="1" />
                        <monitoringControls:MonitoringPickupColumn Header="CH3"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="2" />
                        <monitoringControls:MonitoringPickupColumn Header="CH4"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="3" />
                        <monitoringControls:MonitoringPickupColumn Header="CH5"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="4" />
                        <monitoringControls:MonitoringPickupColumn Header="CH6"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="5" />
                        <monitoringControls:MonitoringPickupColumn Header="CH7"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="6" />
                        <monitoringControls:MonitoringPickupColumn Header="CH8"  LayerIndex="0" ChannelType="Strip"  ChannelIndex="7" />
                        <monitoringControls:MonitoringPickupColumn Header="GR1"  LayerIndex="0" ChannelType="Group"  ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="GR2"  LayerIndex="0" ChannelType="Group"  ChannelIndex="1" />
                        <monitoringControls:MonitoringPickupColumn Header="GR3"  LayerIndex="0" ChannelType="Group"  ChannelIndex="2" />
                        <monitoringControls:MonitoringPickupColumn Header="GR4"  LayerIndex="0" ChannelType="Group"  ChannelIndex="3" />
                        <monitoringControls:MonitoringPickupColumn Header="MST"  LayerIndex="0" ChannelType="Master" ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="RT1"  LayerIndex="0" ChannelType="Return" ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="RT2"  LayerIndex="0" ChannelType="Return" ChannelIndex="1" />
                        <monitoringControls:MonitoringPickupColumn Header="RT3"  LayerIndex="0" ChannelType="Return" ChannelIndex="2" />
                        <monitoringControls:MonitoringPickupColumn Header="RT4"  LayerIndex="0" ChannelType="Return" ChannelIndex="3" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Layer 2">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="4">
                        <monitoringControls:MonitoringPickupColumn Header="CH1"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="CH2"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="1" />
                        <monitoringControls:MonitoringPickupColumn Header="CH3"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="2" />
                        <monitoringControls:MonitoringPickupColumn Header="CH4"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="3" />
                        <monitoringControls:MonitoringPickupColumn Header="CH5"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="4" />
                        <monitoringControls:MonitoringPickupColumn Header="CH6"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="5" />
                        <monitoringControls:MonitoringPickupColumn Header="CH7"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="6" />
                        <monitoringControls:MonitoringPickupColumn Header="CH8"  LayerIndex="1" ChannelType="Strip"  ChannelIndex="7" />
                        <monitoringControls:MonitoringPickupColumn Header="GR1"  LayerIndex="1" ChannelType="Group"  ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="GR2"  LayerIndex="1" ChannelType="Group"  ChannelIndex="1" />
                        <monitoringControls:MonitoringPickupColumn Header="GR3"  LayerIndex="1" ChannelType="Group"  ChannelIndex="2" />
                        <monitoringControls:MonitoringPickupColumn Header="GR4"  LayerIndex="1" ChannelType="Group"  ChannelIndex="3" />
                        <monitoringControls:MonitoringPickupColumn Header="MST"  LayerIndex="1" ChannelType="Master" ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="RT1"  LayerIndex="1" ChannelType="Return" ChannelIndex="0" />
                        <monitoringControls:MonitoringPickupColumn Header="RT2"  LayerIndex="1" ChannelType="Return" ChannelIndex="1" />
                        <monitoringControls:MonitoringPickupColumn Header="RT3"  LayerIndex="1" ChannelType="Return" ChannelIndex="2" />
                        <monitoringControls:MonitoringPickupColumn Header="RT4"  LayerIndex="1" ChannelType="Return" ChannelIndex="3" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="Gray" />

        <!-- Monitor volume channel -->
        <monitoringControls:MonitoringChannelStrip
            Grid.Column="2"
            IsVisible="{Binding Channel, Converter={x:Static ObjectConverters.IsNotNull}}"
            Volume="{Binding Channel.PanAndVolume.Volume}"
            Pan="{Binding Channel.PanAndVolume.Pan}"
            LeftAverage="{Binding Channel.PanAndVolume.LeftAverage}"
            RightAverage="{Binding Channel.PanAndVolume.RightAverage}"
            LeftPeak="{Binding Channel.PanAndVolume.LeftPeak}"
            RightPeak="{Binding Channel.PanAndVolume.RightPeak}" />

    </Grid>
</Window>
