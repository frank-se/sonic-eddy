<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mixerViewModels="clr-namespace:SonicEddy.ViewModels.MixerViewModelsV2"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="620"
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        x:Class="SonicEddy.Views.MixerViewsV2.LooperDetailsWindow"
        x:DataType="mixerViewModels:LooperDetailsViewModel"
        Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*"
          Margin="12"
          RowSpacing="10">
        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{Binding Title}" />

        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Sides}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="mixerViewModels:LooperSideDetailsViewModel">
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="mixerViewModels:LooperSideDetailsViewModel">
                    <Grid RowDefinitions="Auto,*,Auto"
                          RowSpacing="10">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="Auto,*,Auto,*,Auto,*"
                              ColumnSpacing="8"
                              RowSpacing="6">
                            <TextBlock Grid.Column="0" Text="Recording" />
                            <TextBlock Grid.Column="1" Text="{Binding Recording}" />
                            <TextBlock Grid.Column="2" Text="Alignment" />
                            <TextBlock Grid.Column="3" Text="{Binding TransportAlignment}" />
                            <TextBlock Grid.Column="4" Text="Playback" />
                            <TextBlock Grid.Column="5" Text="{Binding ActivePlayback}" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Slots}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding LoopNumber}" />
                                <DataGridTextColumn Header="State"
                                                    Binding="{Binding State}" />
                                <DataGridTextColumn Header="Gen"
                                                    Binding="{Binding Generation}" />
                                <DataGridTextColumn Header="Source"
                                                    Binding="{Binding Source}" />
                                <DataGridTextColumn Header="Beats"
                                                    Binding="{Binding Beats}" />
                                <DataGridTextColumn Header="Length"
                                                    Binding="{Binding Length}" />
                                <DataGridTextColumn Header="Format"
                                                    Binding="{Binding Format}" />
                                <DataGridTextColumn Header="Level"
                                                    Binding="{Binding Level}" />
                                <DataGridTextColumn Header="Range"
                                                    Binding="{Binding Range}" />
                                <DataGridTextColumn Header="BPM"
                                                    Binding="{Binding Bpm}" />
                                <DataGridTemplateColumn Header="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="mixerViewModels:LooperSlotDetailsViewModel">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4">
                                                <Button Padding="8,2"
                                                        Content="Play"
                                                        IsEnabled="{Binding CanPlay}"
                                                        Command="{Binding PlayCommand}" />
                                                <Button Padding="8,2"
                                                        Content="Archive"
                                                        IsEnabled="{Binding CanArchive}"
                                                        Command="{Binding ArchiveCommand}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Padding="18,6"
                                    Content="Stop"
                                    Command="{Binding StopCommand}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding LastFailure}" />
                            <ItemsControl Grid.Column="2"
                                          ItemsSource="{Binding PendingJobs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mixerViewModels:PendingJobDetailsViewModel">
                                        <TextBlock Text="{Binding Kind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
