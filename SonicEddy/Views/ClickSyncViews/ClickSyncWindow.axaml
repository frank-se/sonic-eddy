<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SonicEddy.ViewModels.ClickSyncViewModels"
        mc:Ignorable="d"
        d:DesignWidth="920"
        d:DesignHeight="680"
        Width="1120"
        Height="680"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        x:Class="SonicEddy.Views.ClickSyncViews.ClickSyncWindow"
        x:DataType="vm:ClickSyncViewModel"
        Title="Click Sync">
    <Grid Margin="16"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="280,*"
          ColumnSpacing="16"
          RowSpacing="12">
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              ColumnDefinitions="2*,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     PlaceholderText="Converter name"
                     Text="{Binding NewName}" />
            <NumericUpDown Grid.Column="1"
                           Width="90"
                           Minimum="1"
                           Maximum="96"
                           Increment="1"
                           FormatString="0"
                           Value="{Binding NewPulsesPerQuarterNote}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Text="PPQN" />
            <NumericUpDown Grid.Column="3"
                           Width="100"
                           Minimum="0.1"
                           Maximum="20"
                           Increment="0.1"
                           FormatString="0.0"
                           Value="{Binding NewPulseLengthMs}" />
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Text="ms" />
            <Button Grid.Column="5"
                    Content="Create"
                    IsEnabled="{Binding CanCreate}"
                    Command="{Binding Create}" />
        </Grid>

        <Grid Grid.Row="1"
              Grid.Column="0"
              RowDefinitions="*,Auto"
              RowSpacing="8">
            <ListBox ItemsSource="{Binding Converters}"
                     SelectedItem="{Binding SelectedConverter}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClickSyncConverterViewModel">
                        <StackPanel Margin="4">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Name}" />
                            <TextBlock Opacity="0.7"
                                       Text="{Binding Details}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1"
                    HorizontalAlignment="Left"
                    Content="Delete"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding Delete}" />
        </Grid>

        <Grid Grid.Row="1"
              Grid.Column="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="16"
              IsEnabled="{Binding HasSelection}">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Click output" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding ClickPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClickSyncPortViewModel">
                                <CheckBox Margin="0,4"
                                          IsChecked="{Binding Selected}"
                                          Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="8">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Reset output" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding ResetPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClickSyncPortViewModel">
                                <CheckBox Margin="0,4"
                                          IsChecked="{Binding Selected}"
                                          Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*"
                  RowSpacing="8">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Run output" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding RunPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClickSyncPortViewModel">
                                <CheckBox Margin="0,4"
                                          IsChecked="{Binding Selected}"
                                          Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text="{Binding Status}" />
    </Grid>
</Window>
