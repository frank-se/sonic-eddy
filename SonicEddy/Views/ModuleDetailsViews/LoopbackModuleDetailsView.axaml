<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:moduleDetailsViewModels="clr-namespace:SonicEddy.ViewModels.ModuleDetailsViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Views.ModuleDetailsViews.LoopbackModuleDetailsView"
             x:DataType="moduleDetailsViewModels:LoopbackModuleDetailsViewModel">
    <ScrollViewer>
        <HeaderedContentControl Header="{Binding Name}">
            
        </HeaderedContentControl>
    </ScrollViewer>
</UserControl>