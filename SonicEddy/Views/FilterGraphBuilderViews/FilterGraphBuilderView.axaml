<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:filterGraphBuilderViewModels="clr-namespace:SonicEddy.ViewModels.FilterGraphBuilderViewModels"
             xmlns:controls="clr-namespace:SonicEddy.Controls"
             xmlns:graph="clr-namespace:SonicEddy.ViewModels.FilterGraphBuilderViewModels.Graph.Graph"
             xmlns:lv2="clr-namespace:SonicEddy.ViewModels.FilterGraphBuilderViewModels.Graph.Lv2"
             xmlns:filterGraphBuilderViewModels1="clr-namespace:SonicEddy.ViewModels.FilterGraphBuilderViewModels.Graph"
             xmlns:toolbox="clr-namespace:SonicEddy.ViewModels.FilterGraphBuilderViewModels.Toolbox"
             xmlns:graphEditorControl="clr-namespace:SonicEddy.Controls.GraphEditorControl"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Views.FilterGraphBuilderViews.FilterGraphBuilderView"
             x:DataType="filterGraphBuilderViewModels:FilterGraphBuilderViewModel"
             x:Name="MainControl">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal">
            <Button Content="Save Graph"
                    Margin="4"
                    Padding="4"
                    Command="{Binding SaveGraph}" />
        </StackPanel>
        <SplitView Grid.Row="1"
                   IsPaneOpen="True"
                   DisplayMode="Inline"
                   OpenPaneLength="250"
                   PanePlacement="Right">
            <SplitView.Pane>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Built-in filter nodes -->
                        <Expander Header="Built-in"
                                  HorizontalAlignment="Stretch"
                                  IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding AvailableBuiltins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="toolbox:BuiltinNodeGroupViewModel">
                                        <Expander Header="{Binding Name}"
                                                  HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding Nodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="toolbox:AvailableBuiltinNode">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <Button Grid.Column="0"
                                                                    Content="{Binding DisplayName}"
                                                                    HorizontalAlignment="Stretch"
                                                                    Margin="4,2"
                                                                    Command="{Binding #MainControl.((filterGraphBuilderViewModels:FilterGraphBuilderViewModel)DataContext).AddBuiltinNode}"
                                                                    CommandParameter="{Binding}" />
                                                            <NumericUpDown Grid.Column="1"
                                                                           IsVisible="{Binding HasVariableChannelCount}"
                                                                           Value="{Binding ChannelCount}"
                                                                           Minimum="1" Maximum="8"
                                                                           Increment="1"
                                                                           FormatString="0"
                                                                           Width="64"
                                                                           Margin="0,2,4,2" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- LV2 plugins -->
                        <Expander Header="LV2 Plugins"
                                  HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding AvailablePluginsByClass}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander VerticalAlignment="Top"
                                                  Header="{Binding Name}"
                                                  HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding Plugins}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Description.Name}"
                                                                HorizontalAlignment="Stretch"
                                                                Margin="4,2"
                                                                Command="{Binding #MainControl.((filterGraphBuilderViewModels:FilterGraphBuilderViewModel)DataContext).AddPlugin}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <graphEditorControl:GraphEditorViewport
                GraphInputs="{Binding InputNodeViewModel}"
                GraphOutputs="{Binding OutputNodeViewModel}"
                GraphNodes="{Binding Nodes}"
                GraphEdges="{Binding Connections}" />
        </SplitView>
    </Grid>
</UserControl>
