<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:objectBrowserViewModels="clr-namespace:SonicEddy.ViewModels.ObjectBrowserViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SonicEddy.Views.ObjectBrowserViews.ObjectBrowserWindow"
        Title="Objects" Width="800" Height="1000"
        x:DataType="objectBrowserViewModels:ObjectBrowserViewModel">
    
    <SplitView IsPaneOpen="True"
               DisplayMode="Inline"
               OpenPaneLength="400"
               PanePlacement="Right">
        <SplitView.Pane>
                <TreeView SelectionMode="Single"
                          SelectedItem="{Binding SelectedObject}"
                          ItemsSource="{Binding Objects}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
        </SplitView.Pane>

        <ContentControl Content="{Binding SelectedObjectViewModel}" />
    </SplitView>
</Window>
