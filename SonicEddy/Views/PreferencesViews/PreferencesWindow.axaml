<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:preferencesViewModels="clr-namespace:SonicEddy.ViewModels.PreferencesViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SonicEddy.Views.PreferencesViews.PreferencesWindow"
        x:DataType="preferencesViewModels:PreferencesViewModel"
        Title="Preferences">

    <StackPanel>
        <Grid RowDefinitions="Auto,*"
              ColumnDefinitions="Auto,*">

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Target="DefaultMasterOutputComboBox"
                   Content="Default Master Output" />

            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      x:Name="DefaultMasterOutputComboBox"
                      ItemsSource="{Binding Nodes}"
                      DisplayMemberBinding="{Binding Description}"
                      SelectedItem="{Binding SelectedDefaultMasterOutput}" />

        </Grid>
        
        <StackPanel Orientation="Horizontal">
            
            <Button Content="Revert"
                    IsEnabled="{Binding IsRevertEnabled}"
                    Command="{Binding Revert}" />
            
            <Button Content="Save"
                    IsEnabled="{Binding IsSaveEnabled}"
                    Command="{Binding Save}" />
            
        </StackPanel>
    </StackPanel>
</Window>