<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mixerViewModels="clr-namespace:SonicEddy.ViewModels.MixerViewModels"
             xmlns:mixerViews="clr-namespace:SonicEddy.Views.MixerViews"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Views.MixerViews.MixerView"
             x:DataType="mixerViewModels:MixerViewModel">
    <SplitView IsPaneOpen="True"
               DisplayMode="Inline"
               PanePlacement="Right"
               OpenPaneLength="NaN">
        <SplitView.Pane>
            <HeaderedContentControl x:Name="IconButtonColumn"
                                    Header="Menu"
                                    Margin="4">
                <StackPanel>
                    <Button Content="&#xE005;"
                            FontFamily="{StaticResource FluentIconsRegular}"
                            FontSize="20"
                            ToolTip.Tip="Add Stream ..."
                            Padding="8"
                            Command="{Binding AddStream}"
                            Margin="4" />
                </StackPanel>
            </HeaderedContentControl>
        </SplitView.Pane>

        <HeaderedContentControl Name="HeaderControl" Header="Mixer" Margin="4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Streams}"
                              x:Name="MixerChannelsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mixerViewModels:Stream">
                            <Border Width="100" Margin="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemAccentColorDark1}"
                                    Background="{DynamicResource SystemBaseLowColor}"
                                    VerticalAlignment="Stretch">
                                <HeaderedContentControl
                                    Header="{Binding DisplayName}"
                                    HorizontalAlignment="Center"
                                    Margin="4">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto"
                                          Margin="4">
                                        <Button Grid.Row="0" Content="...">
                                            <!--
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem
                                                        Header="Remove Channel"
                                                        Command="{Binding ElementName=MixerChannelsItemsControl, Path=DataContext.RemoveStream}"
                                                        CommandParameter="{Binding} "/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            -->
                                            <Button.Flyout>
                                                <MenuFlyout
                                                    Placement="BottomEdgeAlignedRight">
                                                    <MenuItem
                                                        Header="Remove Channel"
                                                        Command="{Binding ElementName=MixerChannelsItemsControl, Path=DataContext.RemoveStream}"
                                                        CommandParameter="{Binding} " />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Slider Grid.Row="1"
                                                Margin="4"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                Minimum="{Binding Minimum}"
                                                Maximum="{Binding Maximum}"
                                                Value="{Binding Volume}" />
                                        <Slider Grid.Row="2"
                                                Margin="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Stretch"
                                                Minimum="0.0"
                                                Maximum="1.0"
                                                IsVisible="{Binding IsStereo}"
                                                Value="{Binding Pan}" />
                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException -->
                                        <ComboBox Grid.Row="3"
                                                  Margin="4,12, 4, 4"
                                                  ItemsSource="{Binding $parent[mixerViews:MixerView].((mixerViewModels:MixerViewModel)DataContext).TargetObjects}"
                                                  DisplayMemberBinding="{Binding Description}"
                                                  SelectedValue="{Binding TargetObject, FallbackValue=''}"
                                                  HorizontalAlignment="Center" />
                                    </Grid>
                                </HeaderedContentControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </HeaderedContentControl>
    </SplitView>
</UserControl>