<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mixerViewModels="clr-namespace:SonicEddy.ViewModels.MixerViewModels"
             xmlns:controls="clr-namespace:SonicEddy.Controls"
             xmlns:mixerViews="clr-namespace:SonicEddy.Views.MixerViews"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Views.MixerViews.MixerView"
             x:DataType="mixerViewModels:MixerViewModel">
    <HeaderedContentControl Header="Mixer"
                            Margin="4">
        <ItemsControl ItemsSource="{Binding Channels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,300,*,Auto"
                          Margin="4">
                        <Button Grid.Row="0"
                                Margin="4"
                                HorizontalAlignment="Stretch"
                                Content="Filters"
                                Command="{Binding SetFilterChain}" />

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="4"
                                                Height="300"
                                                Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <mixerViews:PluginView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <controls:ValueSlider Grid.Row="2"
                                              Margin="4"
                                              Maximum="10"
                                              IsVertical="True"
                                              Text="Volume"
                                              Background="DimGray"
                                              Value="{Binding Volume}" />

                        <controls:PanSlider Grid.Row="3"
                                            Margin="4"
                                            Maximum="1"
                                            Text="Pan"
                                            Background="DimGray"
                                            Value="{Binding Pan}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </HeaderedContentControl>
</UserControl>