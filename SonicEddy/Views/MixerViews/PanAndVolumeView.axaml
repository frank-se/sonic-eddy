<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mixerViewModels="clr-namespace:SonicEddy.ViewModels.MixerViewModels"
             xmlns:controls="clr-namespace:SonicEddy.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="mixerViewModels:PanAndVolumeViewModel"
             x:Class="SonicEddy.Views.MixerViews.PanAndVolumeView">
    <Grid RowDefinitions="*,Auto">
        <controls:ValueSlider Grid.Row="0"
                              Margin="4"
                              Maximum="1"
                              IsVertical="True"
                              Text="Volume"
                              Background="DimGray"
                              Value="{Binding Volume}" />

        <controls:PanSlider Grid.Row="1"
                            Margin="4"
                            Maximum="1"
                            Text="Pan"
                            Background="DimGray"
                            Value="{Binding Pan}" />
    </Grid>
</UserControl>