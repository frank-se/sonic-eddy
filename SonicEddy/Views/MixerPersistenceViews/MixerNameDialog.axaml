<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SonicEddy.ViewModels.MixerPersistenceViewModels"
        Width="320"
        SizeToContent="Height"
        x:Class="SonicEddy.Views.MixerPersistenceViews.MixerNameDialog"
        x:DataType="vm:MixerNameDialogViewModel"
        Title="Save Mixer">
    <StackPanel Margin="8">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Label Grid.Column="0" Content="Name" Target="NameTextBox"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" x:Name="NameTextBox"
                     Text="{Binding Name}" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel" Command="{Binding Cancel}" />
            <Button Content="Save" Command="{Binding Save}"
                    IsEnabled="{Binding IsButtonEnabled}" />
        </StackPanel>
    </StackPanel>
</Window>
