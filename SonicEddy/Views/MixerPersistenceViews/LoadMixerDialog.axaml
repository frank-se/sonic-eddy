<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SonicEddy.ViewModels.MixerPersistenceViewModels"
        Width="420"
        Height="320"
        x:Class="SonicEddy.Views.MixerPersistenceViews.LoadMixerDialog"
        x:DataType="vm:LoadMixerDialogViewModel"
        Title="Load Mixer">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding Cancel}" />
            <Button Content="Load" Command="{Binding Load}"
                    IsEnabled="{Binding IsButtonEnabled}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Mixers}"
                 SelectedItem="{Binding SelectedMixer}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
