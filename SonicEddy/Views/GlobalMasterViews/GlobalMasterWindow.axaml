<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mixerControls="clr-namespace:SonicEddy.Controls.MixerControls"
        xmlns:controls="clr-namespace:SonicEddy.Controls"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
        Width="400" Height="900"
        WindowStartupLocation="CenterOwner"
        x:CompileBindings="False"
        x:Class="SonicEddy.Views.GlobalMasterViews.GlobalMasterWindow"
        Title="Global Master">

    <Grid RowDefinitions="*,Auto">

        <!-- Three channel strips side by side — fills all available height -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="4,4,4,0">

            <!-- Cue channel strip — only shown when a cue output is configured -->
            <mixerControls:CueChannelStrip
                IsVisible="{Binding HasCue}"
                Volume="{Binding CueChannel.PanAndVolume.Volume}"
                Pan="{Binding CueChannel.PanAndVolume.Pan}"
                LeftAverage="{Binding CueChannel.PanAndVolume.LeftAverage}"
                RightAverage="{Binding CueChannel.PanAndVolume.RightAverage}"
                LeftPeak="{Binding CueChannel.PanAndVolume.LeftPeak}"
                RightPeak="{Binding CueChannel.PanAndVolume.RightPeak}"
                AudioToRoutingTargets="{Binding CueChannel.AudioToRoutingTargets}"
                SelectedAudioToRoutingTarget="{Binding CueChannel.SelectedAudioToRoutingTarget}" />

            <!-- Strip bound entirely from its own DataContext (LayerA) -->
            <mixerControls:MasterChannelStrip
                DataContext="{Binding LayerA}"
                Text="Layer A"
                IsSelected="{Binding IsSelected}"
                SelectCommand="{Binding SelectChannelCommand}"
                HasFilter="{Binding HasFilter}"
                AddFilterCommand="{Binding AddFilterAction}"
                DeleteFilterCommand="{Binding DeleteFilterAction}"
                Presets="{Binding AvailablePresets}"
                SavePresetCommand="{Binding SavePresetCommand}"
                LoadPresetCommand="{Binding LoadPresetCommand}"
                FirstPluginParameters="{Binding FirstPluginParameters}"
                FirstPluginText="{Binding FirstPluginText}"
                SecondPluginParameters="{Binding SecondPluginParameters}"
                SecondPluginText="{Binding SecondPluginText}"
                ThirdPluginParameters="{Binding ThirdPluginParameters}"
                ThirdPluginText="{Binding ThirdPluginText}"
                Volume="{Binding PanAndVolume.Volume}"
                Pan="{Binding PanAndVolume.Pan}"
                LeftAverage="{Binding PanAndVolume.LeftAverage}"
                RightAverage="{Binding PanAndVolume.RightAverage}"
                LeftPeak="{Binding PanAndVolume.LeftPeak}"
                RightPeak="{Binding PanAndVolume.RightPeak}"
                AudioToRoutingTargets="{Binding AudioToRoutingTargets}"
                SelectedAudioToRoutingTarget="{Binding SelectedAudioToRoutingTarget}"
                IsFilterMidiControlled="{Binding IsFilterMidiControlled}"
                FirstPluginParametersMidiControlled="{Binding FirstPluginSelectedForMidi}"
                SecondPluginParametersMidiControlled="{Binding SecondPluginSelectedForMidi}"
                ThirdPluginParametersMidiControlled="{Binding ThirdPluginSelectedForMidi}" />

            <!-- Strip bound entirely from its own DataContext (LayerB) -->
            <mixerControls:MasterChannelStrip
                DataContext="{Binding LayerB}"
                Text="Layer B"
                IsSelected="{Binding IsSelected}"
                SelectCommand="{Binding SelectChannelCommand}"
                HasFilter="{Binding HasFilter}"
                AddFilterCommand="{Binding AddFilterAction}"
                DeleteFilterCommand="{Binding DeleteFilterAction}"
                Presets="{Binding AvailablePresets}"
                SavePresetCommand="{Binding SavePresetCommand}"
                LoadPresetCommand="{Binding LoadPresetCommand}"
                FirstPluginParameters="{Binding FirstPluginParameters}"
                FirstPluginText="{Binding FirstPluginText}"
                SecondPluginParameters="{Binding SecondPluginParameters}"
                SecondPluginText="{Binding SecondPluginText}"
                ThirdPluginParameters="{Binding ThirdPluginParameters}"
                ThirdPluginText="{Binding ThirdPluginText}"
                Volume="{Binding PanAndVolume.Volume}"
                Pan="{Binding PanAndVolume.Pan}"
                LeftAverage="{Binding PanAndVolume.LeftAverage}"
                RightAverage="{Binding PanAndVolume.RightAverage}"
                LeftPeak="{Binding PanAndVolume.LeftPeak}"
                RightPeak="{Binding PanAndVolume.RightPeak}"
                AudioToRoutingTargets="{Binding AudioToRoutingTargets}"
                SelectedAudioToRoutingTarget="{Binding SelectedAudioToRoutingTarget}"
                IsFilterMidiControlled="{Binding IsFilterMidiControlled}"
                FirstPluginParametersMidiControlled="{Binding FirstPluginSelectedForMidi}"
                SecondPluginParametersMidiControlled="{Binding SecondPluginSelectedForMidi}"
                ThirdPluginParametersMidiControlled="{Binding ThirdPluginSelectedForMidi}" />

        </StackPanel>

        <!-- Crossfader section — cue xfader on the left, main xfader on the right -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="8,4,8,8">

            <!-- Cue crossfader — under the cue channel strip, only when cue is configured -->
            <Border IsVisible="{Binding HasCue}"
                    Width="124"
                    Padding="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    CornerRadius="4">
                <StackPanel Spacing="8">

                    <TextBlock Text="Cue" FontWeight="SemiBold" />

                    <controls:PanSlider Text="xfade"
                                        Value="{Binding CueXfade, Mode=TwoWay}"
                                        Maximum="1"
                                        Background="DimGray"
                                        Height="40" />

                    <StackPanel Spacing="6">
                        <ComboBox SelectedIndex="{Binding CueShapeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Linear" />
                            <ComboBoxItem Content="Equal Power" />
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding CueModeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="X-fade" />
                            <ComboBoxItem Content="V-fade" />
                        </ComboBox>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Main crossfader -->
            <Border Padding="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    CornerRadius="4"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">

                    <TextBlock Text="Main" FontWeight="SemiBold" />

                    <controls:PanSlider Text="xfade"
                                        Value="{Binding Xfade, Mode=TwoWay}"
                                        Maximum="1"
                                        Background="DimGray"
                                        Height="40" />

                    <StackPanel Spacing="6">
                        <ComboBox SelectedIndex="{Binding ShapeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Linear" />
                            <ComboBoxItem Content="Equal Power" />
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="X-fade" />
                            <ComboBoxItem Content="V-fade" />
                        </ComboBox>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>

</Window>
