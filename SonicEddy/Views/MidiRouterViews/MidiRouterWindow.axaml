<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:graphEditorControl="clr-namespace:SonicEddy.Controls.GraphEditorControl"
        xmlns:midiRouterVm="clr-namespace:SonicEddy.ViewModels.MidiRouterViewModels"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
        Width="980" Height="680"
        WindowStartupLocation="CenterOwner"
        x:Class="SonicEddy.Views.MidiRouterViews.MidiRouterWindow"
        x:DataType="midiRouterVm:MidiRouterViewModel"
        Title="MIDI Router">
    <Grid RowDefinitions="Auto,*,Auto,180"
          Margin="12"
          RowSpacing="10">
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Status}" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1">
            <graphEditorControl:GraphEditor GraphInputs="{Binding Sources}"
                                            GraphOutputs="{Binding Targets}"
                                            GraphEdges="{Binding Routes}"
                                            CreateEdgeCommand="{Binding CreateEdgeCommand}"
                                            Background="#222222" />
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Routes" />

        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  ItemsSource="{Binding RouteLinks}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Source"
                                    Width="*"
                                    Binding="{Binding Source}" />
                <DataGridTextColumn Header="Target"
                                    Width="*"
                                    Binding="{Binding Target}" />
                <DataGridTemplateColumn Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="midiRouterVm:MidiRouteLinkViewModel">
                            <Button Padding="10,2"
                                    Content="Delete"
                                    Command="{Binding DeleteCommand}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
