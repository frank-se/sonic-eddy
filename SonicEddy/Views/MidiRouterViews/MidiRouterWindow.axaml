<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:midiRouterVm="clr-namespace:SonicEddy.ViewModels.MidiRouterViewModels"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="520"
        Width="780" Height="520"
        WindowStartupLocation="CenterOwner"
        x:Class="SonicEddy.Views.MidiRouterViews.MidiRouterWindow"
        x:DataType="midiRouterVm:MidiRouterViewModel"
        Title="MIDI Router">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="12"
          RowSpacing="12">
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Status}" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,*,Auto"
              ColumnSpacing="8">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding SelectedSource}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="midiRouterVm:MidiRouterPortOptionViewModel">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="to" />

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Targets}"
                      SelectedItem="{Binding SelectedTarget}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="midiRouterVm:MidiRouterPortOptionViewModel">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="3"
                    Padding="18,4"
                    Content="Connect"
                    IsEnabled="{Binding CanConnect}"
                    Command="{Binding ConnectCommand}" />
        </Grid>

        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  ItemsSource="{Binding RouteLinks}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Source"
                                    Width="*"
                                    Binding="{Binding Source}" />
                <DataGridTextColumn Header="Target"
                                    Width="*"
                                    Binding="{Binding Target}" />
                <DataGridTemplateColumn Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="midiRouterVm:MidiRouteLinkViewModel">
                            <Button Padding="10,2"
                                    Content="Delete"
                                    Command="{Binding DeleteCommand}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   TextWrapping="Wrap"
                   Text="MIDI/control routes are created as direct PipeWire port links. Use this for MIDI bridge hardware ports and internal control ports." />
    </Grid>
</Window>
