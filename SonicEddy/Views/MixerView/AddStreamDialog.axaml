<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mixerViewModel="clr-namespace:SonicEddy.ViewModels.MixerViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        Title="Select the stream"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        x:Class="SonicEddy.Views.MixerView.AddStreamDialog"
        x:DataType="mixerViewModel:AddStreamDialogViewModel">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ListBox Grid.Row="0"
                 SelectedItem="{Binding SelectedStream}"
                 ItemsSource="{Binding AvailableStreams}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Description}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="4">
            <Button Content="Cancel"
                    Command="{Binding CancelAction}" />
            <Button Content="Add Stream"
                    Command="{Binding AddStreamAction}"
                    IsEnabled="{Binding SelectedStream, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </Grid>
</Window>