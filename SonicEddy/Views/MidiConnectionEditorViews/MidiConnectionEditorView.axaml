<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:graphEditorControl="clr-namespace:SonicEddy.Controls.GraphEditorControl"
             xmlns:midiConnectionEditorViewModels="clr-namespace:SonicEddy.ViewModels.MidiConnectionEditorViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="midiConnectionEditorViewModels:MidiConnectionEditorViewModel"
             x:Class="SonicEddy.Views.MidiConnectionEditorViews.MidiConnectionEditorView">
    <HeaderedContentControl Header="Midi Connections"
                            Margin="4">
        <graphEditorControl:GraphEditor GraphInputs="{Binding InputPorts}"
                                        GraphOutputs="{Binding OutputPorts}"
                                        GraphEdges="{Binding Connections}"
                                        Background="SlateBlue" />
    </HeaderedContentControl>
</UserControl>