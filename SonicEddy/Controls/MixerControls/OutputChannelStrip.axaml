<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mixerControls="clr-namespace:SonicEddy.Controls.MixerControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicEddy.Controls.MixerControls.OutputChannelStrip">
    
    <Panel Background="DarkRed">
        <Grid ColumnDefinitions="100"
              RowDefinitions="Auto,Auto,*"
              Margin="2">

            <mixerControls:ChannelHeader Grid.Row="0"
                                         Text="{Binding $parent[mixerControls:OutputChannelStrip].Text}"
                                         IsSelected="{Binding $parent[mixerControls:OutputChannelStrip].IsSelected}"
                                         SelectCommand="{Binding $parent[mixerControls:OutputChannelStrip].SelectCommand}"
                                         SelectCommandParameter="{Binding $parent[mixerControls:OutputChannelStrip].SelectCommandParameter}"
                                         IsDeleteButtonVisible="False" />

            <mixerControls:PanAndVolumeSection Grid.Row="2"
                                               Volume="{Binding $parent[mixerControls:OutputChannelStrip].Volume}"
                                               Pan="{Binding $parent[mixerControls:OutputChannelStrip].Pan}" />
            
        </Grid>
    </Panel>
    
</UserControl>
