<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SonicEddy.Controls"
             xmlns:mixerControls="clr-namespace:SonicEddy.Controls.MixerControls"
             x:CompileBindings="False"
             x:Class="SonicEddy.Controls.MixerControls.LooperCompactSection">

    <UserControl.Styles>
        <Style Selector="Button, ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="30,36,28,28"
          Margin="4,4,4,16"
          RowSpacing="3">

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <TextBlock Text="Looper"
                       FontSize="12"
                       Margin="6" />
        </StackPanel>

        <!-- Row 1: Cut/Play, Stop, Mix -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Rows="1"
                     ColumnSpacing="2">
            <Button Content="&#xF608;"
                    FontFamily="{StaticResource FluentIconsRegular}"
                    FontSize="18"
                    Foreground="{Binding ActionForeground}"
                    Command="{Binding CutPlayCommand}">
                <ToolTip.Tip>Cut and play</ToolTip.Tip>
            </Button>
            <Button Content="&#xF759;"
                    FontFamily="{StaticResource FluentIconsRegular}"
                    FontSize="18"
                    Command="{Binding StopCommand}">
                <ToolTip.Tip>Stop</ToolTip.Tip>
            </Button>
            <controls:ValueSlider Minimum="0"
                                  Maximum="1"
                                  Background="Gray"
                                  Text="Mix"
                                  Value="{Binding Mix}" />
        </UniformGrid>

        <!-- Row 2: Bar length toggle buttons (exclusive) -->
        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Rows="1"
                     ColumnSpacing="2">
            <ToggleButton IsChecked="{Binding IsLength1}">
                <ToolTip.Tip>1 bar</ToolTip.Tip>
                1
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsLength2}">
                <ToolTip.Tip>2 bars</ToolTip.Tip>
                2
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsLength4}">
                <ToolTip.Tip>4 bars</ToolTip.Tip>
                4
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsLength8}">
                <ToolTip.Tip>8 bars</ToolTip.Tip>
                8
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsLength16}">
                <ToolTip.Tip>16 bars</ToolTip.Tip>
                16
            </ToggleButton>
        </UniformGrid>

        <!-- Row 3: Pre/Post pickup, Quantize, Details -->
        <UniformGrid Grid.Row="3"
                     Columns="3"
                     Rows="1"
                     ColumnSpacing="2">
            <ToggleButton Content="{Binding ActivePositionIcon}"
                          FontFamily="{StaticResource FluentIconsRegular}"
                          FontSize="18"
                          Foreground="{Binding ActionForeground}"
                          IsChecked="{Binding IsPostFxSelected}">
                <ToolTip.Tip>Pre/post FX pickup</ToolTip.Tip>
            </ToggleButton>
            <ToggleButton Content="&#xF3FC;"
                          FontFamily="{StaticResource FluentIconsRegular}"
                          FontSize="18"
                          IsChecked="{Binding IsQuantized}">
                <ToolTip.Tip>Quantize to phrase start</ToolTip.Tip>
            </ToggleButton>
            <Button Content="&#xF692;"
                    FontFamily="{StaticResource FluentIconsRegular}"
                    FontSize="18"
                    Command="{Binding ShowDetailsCommand}">
                <ToolTip.Tip>Details</ToolTip.Tip>
            </Button>
        </UniformGrid>

    </Grid>
</UserControl>
